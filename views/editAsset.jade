extends adminLayout

block content
  // Page Header
  .d-flex.flex-wrap.justify-content-between.align-items-center.gap-3.mb-4
    div
      h1.mb-1 Edit Asset
      p.text-secondary.mb-0 Update asset information, category, and status.

    a.btn.btn-outline-secondary.btn-back(href="/assets")
      span(aria-hidden="true") ←
      | Back to Asset Master

  // Asset Information Form
  .card.border-0.shadow-sm
    .card-header.bg-white.py-3
      .d-flex.align-items-center.gap-2
        .asset-form-icon
          span(aria-hidden="true") ✎
        div
          h5.mb-1 Asset Information
          small.text-secondary Edit the asset details below.

    .card-body.p-4
      form(action="/assets/edit/" + asset.id, method="POST")
        .row.g-4

          // Asset Code
          .col-12.col-md-6
            label.form-label(for="assetCode") Asset Code
            input#assetCode.form-control(
              type="text"
              name="assetCode"
              value=asset.assetCode
              placeholder="e.g. AST001"
              required
            )

          // Serial Number
          .col-12.col-md-6
            label.form-label(for="serialNumber") Serial Number
            input#serialNumber.form-control(
              type="text"
              name="serialNumber"
              value=asset.serialNumber
              placeholder="Enter serial number"
              required
            )

          // Asset Category
          .col-12.col-md-6
            label.form-label(for="assetCategoryId") Asset Category
            select#assetCategoryId.form-select(
              name="assetCategoryId"
              required
            )
              option(value="") Select Category
              each category in categories
                option(
                  value=category.id
                  selected=String(category.id) === String(asset.assetCategoryId)
                )= category.categoryName

          // Make
          .col-12.col-md-6
            label.form-label(for="make") Make
            input#make.form-control(
              type="text"
              name="make"
              value=asset.make
              placeholder="e.g. Dell, HP, Lenovo"
              required
            )

          // Model
          .col-12.col-md-6
            label.form-label(for="model") Model
            input#model.form-control(
              type="text"
              name="model"
              value=asset.model
              placeholder="Enter asset model"
              required
            )

          // Branch
          .col-12.col-md-6
            label.form-label(for="branch") Branch
            input#branch.form-control(
              type="text"
              name="branch"
              value=asset.branch
              placeholder="Enter branch location"
              required
            )

          // Purchase Date
          .col-12.col-md-6
            label.form-label(for="purchaseDate") Purchase Date
            input#purchaseDate.form-control(
              type="date"
              name="purchaseDate"
              value=asset.purchaseDate
              required
            )

          // Purchase Value
          .col-12.col-md-6
            label.form-label(for="purchaseValue") Purchase Value
            .input-group
              span.input-group-text ₹
              input#purchaseValue.form-control(
                type="number"
                name="purchaseValue"
                value=asset.purchaseValue
                placeholder="0.00"
                min="0"
                step="0.01"
                required
              )

          // Asset Status
          .col-12.col-md-6
            label.form-label(for="status") Asset Status
            select#status.form-select(name="status" required)
              option(
                value="Available"
                selected=asset.status === "Available"
              ) Available
              option(
                value="Issued"
                selected=asset.status === "Issued"
              ) Issued
              option(
                value="Scrapped"
                selected=asset.status === "Scrapped"
              ) Scrapped

        // Form Actions
        hr.my-4

        .d-flex.flex-wrap.justify-content-end.gap-2
          a.btn.btn-light.border(href="/assets") Cancel
          button.btn.btn-success(type="submit")
            span.me-2(aria-hidden="true") ✓
            | Update Asset