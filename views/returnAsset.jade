
extends adminLayout

block content
  // Page Header
  .d-flex.flex-wrap.justify-content-between.align-items-center.gap-3.mb-4
    div
      h1.mb-1 Return Asset
      p.text-secondary.mb-0 Manage assets returned by employees and record return reasons.

    a.btn.btn-outline-secondary.btn-back(href="/admin")
      span(aria-hidden="true") ←
      | Back to Dashboard

  // Success Message
  if success
    .alert.alert-success.alert-dismissible.fade.show.border-0.shadow-sm.mb-4(role="alert")
      .d-flex.align-items-center.gap-2
        span.fs-5(aria-hidden="true") ✓
        div
          strong Asset returned successfully!
          p.mb-0 The asset return has been recorded.
      button.btn-close(type="button" data-bs-dismiss="alert" aria-label="Close")

  // Return Summary
  .row.g-3.mb-4
    .col-12.col-md-6
      .card.border-0.shadow-sm.return-summary-card
        .card-body.p-4
          .d-flex.justify-content-between.align-items-center.gap-3
            div
              p.text-secondary.mb-2 Currently Issued Assets
              h3.mb-0= transactions.length
            .return-summary-icon.return-icon-teal
              span(aria-hidden="true") 📦

  // No Issued Assets
  if transactions.length === 0
    .card.border-0.shadow-sm
      .card-body.text-center.py-5.px-3
        .return-empty-icon.mb-3
          span(aria-hidden="true") 📦
        h5.mb-2 No Assets Currently Issued
        p.text-secondary.mb-0 There are no issued assets waiting to be returned.

  else
    // Return Assets Table
    .card.border-0.shadow-sm.return-table-card
      .card-header.bg-white.border-bottom.p-4
        .d-flex.flex-wrap.justify-content-between.align-items-center.gap-3
          div
            h5.mb-1 Issued Assets
            p.text-secondary.mb-0 Review the asset and employee details before recording a return.

          span.badge.rounded-pill.text-bg-light.border.return-count-label
            | Total: #{transactions.length}


      .card-body.p-3
        table#returnAssetsTable.table.table-hover.align-middle.mb-0.w-100(style="min-width: 1100px;")
          thead
            tr
              th.px-4.py-3(scope="col") Asset Code
              th.py-3(scope="col") Make / Model
              th.py-3(scope="col") Employee
              th.py-3(scope="col") Issue Date
              th.py-3(scope="col") Return Date
              th.py-3(scope="col") Return Reason
              th.py-3.pe-4(scope="col") Action

          tbody
            each item in transactions
              tr
                td.px-4
                  span.return-asset-code= item.Asset ? item.Asset.assetCode : "N/A"

                td
                  div.fw-semibold= item.Asset ? `${item.Asset.make} ${item.Asset.model}` : "N/A"

                td
                  if item.Employee
                    div.fw-semibold= item.Employee.employeeCode
                    small.text-secondary= `${item.Employee.firstName} ${item.Employee.lastName}`
                  else
                    span.text-secondary N/A

                td
                  span.return-date-text= item.issueDate

                td
                  form(id=`return-form-${item.id}`, method="POST", action="/transactions/return")
                    input(type="hidden", name="transactionId", value=item.id)
                    input.form-control.form-control-sm.return-date-input(
                      type="date"
                      name="returnDate"
                      required
                      aria-label="Return date"
                    )

                td
                  select.form-select.form-select-md.return-reason-select(
                    name="returnReason"
                    form=`return-form-${item.id}`
                    required
                    aria-label="Return reason"
                  )
                    option(value="") Select reason
                    option(value="Upgrade") Upgrade
                    option(value="Resignation") Resignation
                    option(value="Repair") Repair
                    option(value="Other") Other

                td.pe-4
                  button.btn.btn-sm.btn-return-asset(
                    type="submit"
                    form=`return-form-${item.id}`
                  )
                    span.me-1(aria-hidden="true") ✓
                    | Return

      .card-footer.bg-white.border-top.py-3.px-4
        small.text-secondary
          | Select a return date and reason for each asset before submitting.


block scripts
  if transactions.length > 0
    script.
      $(document).ready(function () {
        $('#returnAssetsTable').DataTable({
          pageLength: 10,
          lengthMenu: [5, 10, 25, 50],
          searching: true,
          ordering: true,
          paging: true,
          info: true,
          autoWidth: false,
          scrollX: true,
          order: [],

          columnDefs: [
            {
              orderable: false,
              targets: [4, 5, 6]
            }
          ],

          language: {
            search: "Search returned assets:",
            lengthMenu: "Show _MENU_ assets",
            info: "Showing _START_ to _END_ of _TOTAL_ assets",
            infoEmpty: "No assets available",
            zeroRecords: "No matching assets found",

            paginate: {
              previous: "Previous",
              next: "Next"
            }
          }
        });
      });