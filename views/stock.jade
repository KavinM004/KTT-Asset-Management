extends adminLayout

block content
  // Page Header
  .d-flex.flex-wrap.justify-content-between.align-items-center.gap-3.mb-4
    div
      h1.mb-1 Stock Overview
      p.text-secondary.mb-0 Monitor available assets, branch stock, and inventory value.

    a.btn.btn-outline-secondary.btn-back(href="/admin")
      span(aria-hidden="true") ←
      | Back to Dashboard

  // Summary Cards
  .row.g-3.mb-4
    .col-12.col-sm-6.col-xl-4
      .card.border-0.shadow-sm.stock-summary-card
        .card-body.p-4
          .d-flex.justify-content-between.align-items-center.gap-3
            div
              p.text-secondary.mb-2 Available Assets
              h3.mb-0= assets.length
            .stock-summary-icon.stock-icon-teal
              span(aria-hidden="true") 📦

    .col-12.col-sm-6.col-xl-4
      .card.border-0.shadow-sm.stock-summary-card
        .card-body.p-4
          .d-flex.justify-content-between.align-items-center.gap-3
            div
              p.text-secondary.mb-2 Branches with Available Stock
              h3.mb-0= branchTotals.length
            .stock-summary-icon.stock-icon-dark
              span(aria-hidden="true") 🏢

    .col-12.col-sm-6.col-xl-4
      .card.border-0.shadow-sm.stock-summary-card
        .card-body.p-4
          p.text-secondary.mb-2 Total Available Stock Value
          h3.mb-0.stock-value= "₹" + Number(totalStockValue).toLocaleString("en-IN", { minimumFractionDigits: 2, maximumFractionDigits: 2 })

  // Branch-Wise Stock Summary
  .card.border-0.shadow-sm.mb-4
    .card-header.bg-white.py-3
      .d-flex.flex-wrap.justify-content-between.align-items-center.gap-2
        div
          h5.mb-1 Available Stock by Branch
          small.text-secondary Summary of available assets at each branch.

        span.badge.rounded-pill.text-bg-light.border.stock-count-label
          | Branches: #{branchTotals.length}

    .card-body.p-0
      if branchTotals.length
        .table-responsive
          table.table.table-hover.align-middle.mb-0
            thead
              tr
                th.px-4.py-3(scope="col") Branch
                th.py-3.text-center(scope="col") Available Asset Count
                th.py-3.text-end.pe-4(scope="col") Total Value

            tbody
              each item in branchTotals
                tr
                  td.px-4
                    strong= item.branch
                  td.text-center
                    span.badge.stock-count-badge= item.totalAssets
                  td.text-end.pe-4
                    span.fw-semibold= "₹" + Number(item.totalValue).toLocaleString("en-IN", { minimumFractionDigits: 2, maximumFractionDigits: 2 })
      else
        .text-center.py-5.px-3
          .stock-empty-icon.mb-3
            span(aria-hidden="true") 📦
          h6.mb-2 No Available Stock
          p.text-secondary.mb-0 No available stock was found for any branch.

  // Available Asset Details
  .card.border-0.shadow-sm
    .card-header.bg-white.py-3
      .d-flex.flex-wrap.justify-content-between.align-items-center.gap-3
        div
          h5.mb-1 Available Asset Details
          small.text-secondary View the details of assets currently available in stock.

        span.badge.rounded-pill.text-bg-light.border.stock-count-label
          | Total Assets: #{assets.length}

    .card-body.p-3
      if assets.length
        // DataTables Asset Table
        table#stockAssetsTable.table.table-hover.align-middle.mb-0.w-100
          thead
            tr
              th.px-4.py-3(scope="col") Asset Code
              th.py-3(scope="col") Serial Number
              th.py-3(scope="col") Category
              th.py-3(scope="col") Make
              th.py-3(scope="col") Model
              th.py-3(scope="col") Branch
              th.py-3(scope="col") Purchase Date
              th.py-3.text-end.pe-4(scope="col") Purchase Value

          tbody
            each asset in assets
              tr
                td.px-4
                  span.stock-asset-code= asset.assetCode
                td= asset.serialNumber
                td
                  span.badge.stock-category-badge= asset.AssetCategory ? asset.AssetCategory.categoryName : "Not assigned"
                td= asset.make
                td= asset.model
                td= asset.branch
                td= asset.purchaseDate
                td.text-end.pe-4.fw-semibold= "₹" + Number(asset.purchaseValue).toLocaleString("en-IN", { minimumFractionDigits: 2, maximumFractionDigits: 2 })

          tfoot
            tr
              th.px-4.py-3(colspan="7") Total Available Stock Value
              th.py-3.text-end.pe-4= "₹" + Number(totalStockValue).toLocaleString("en-IN", { minimumFractionDigits: 2, maximumFractionDigits: 2 })

      else
        .text-center.py-5.px-3
          .stock-empty-icon.mb-3
            span(aria-hidden="true") 📦
          h6.mb-2 No Assets Available
          p.text-secondary.mb-0 There are currently no assets available in stock.

  // DataTables Setup
  if assets.length > 0
    script.
      $(document).ready(function () {
        const table = document.getElementById("stockAssetsTable");

        if (table && !$.fn.DataTable.isDataTable(table)) {
          $(table).DataTable({
            pageLength: 10,
            lengthMenu: [5, 10, 25, 50],
            searching: true,
            ordering: true,
            paging: true,
            info: true,
            autoWidth: false,
            scrollX: true,
            order: [],
            language: {
              search: "Search assets:",
              lengthMenu: "Show _MENU_ assets",
              info: "Showing _START_ to _END_ of _TOTAL_ assets",
              infoEmpty: "No assets available",
              zeroRecords: "No matching assets found",
              paginate: {
                previous: "Previous",
                next: "Next"
              }
            },
            columnDefs: [
              {
                targets: 7,
                className: "text-end"
              }
            ]
          });
        }
      });