
doctype html
html
  head
    title= title || "Asset Management System"
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")

    link(rel="stylesheet", href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css")
    link(rel="stylesheet", href="https://cdn.datatables.net/2.3.4/css/dataTables.bootstrap5.min.css")

    script(src="https://code.jquery.com/jquery-3.7.1.min.js")
    script(src="https://cdn.datatables.net/2.3.4/js/dataTables.min.js")
    script(src="https://cdn.datatables.net/2.3.4/js/dataTables.bootstrap5.min.js")

    link(rel="stylesheet", href="/css/style.css")
    block head

  body
    .dashboard-layout
      aside.app-sidebar
        a.app-brand(href="/admin")
          img(src="/images/ktt_logo.jpg", alt="KT Logo")
          span Asset Management

        nav.app-nav
          .nav-heading Main Menu

          a(href="/admin", class=(activePage === "dashboard" ? "active" : ""))
            span 🏠
            span Dashboard

          .nav-heading Masters

          a(href="/employees", class=(activePage === "employees" ? "active" : ""))
            span 👥
            span Employees

          a(href="/assets", class=(activePage === "assets" ? "active" : ""))
            span 💻
            span Assets

          a(href="/asset-categories", class=(activePage === "categories" ? "active" : ""))
            span 🗂️
            span Asset Categories

          a(href="/stock", class=(activePage === "stock" ? "active" : ""))
            span 📦
            span Stock View

          .nav-heading Transactions

          a(href="/transactions/issue", class=(activePage === "issue" ? "active" : ""))
            span 📤
            span Issue Asset

          a(href="/transactions/return", class=(activePage === "return" ? "active" : ""))
            span 📥
            span Return Asset

          a(href="/transactions/scrap", class=(activePage === "scrap" ? "active" : ""))
            span 🗑️
            span Scrap Asset

          .nav-heading Insights

          a(href="/history", class=(activePage === "history" ? "active" : ""))
            span 📋
            span Asset History

          a(href="/reports", class=(activePage === "reports" ? "active" : ""))
            span 📊
            span Reports

      main.dashboard-main
        header.topbar
          div
            h5.mb-1= title || "Asset Management"
            p.account-email.mb-0 Welcome, Admin!

          div.d-flex.align-items-center.gap-3
            div.text-end
              strong.d-block Admin
              span.account-email= typeof user !== "undefined" && user ? user.email : ""

            form(action="/logout", method="POST").mb-0
              button.btn.btn-danger(type="submit") Logout

        section.dashboard-content
          block content

    // Page-specific JavaScript
    block scripts

    script.
      window.addEventListener("pageshow", function (event) {
        if (event.persisted) {
          window.location.reload();
        }
      });
